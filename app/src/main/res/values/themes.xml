<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="porcelain">#F3F6FA</color>
    <color name="cobalt">#1F4FA3</color>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/cobalt</item>
        <item name="android:colorAccent">@color/cobalt</item>
        <item name="android:statusBarColor">@color/porcelain</item>
        <item name="android:navigationBarColor">@color/porcelain</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/porcelain</item>
    </style>
</resources>
